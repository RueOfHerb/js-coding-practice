{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "plugins": ["jest"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "overrides": [
    {
      "files": ["**/*.test.js"],
      "env": {
        "jest/globals": true
      }
    }
  ],
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }]
  }
}
